DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alternatech
DB_USER=alternatech
DB_PASSWORD=
# Optional PEM CA file; required for the remote database scheduled sync workflow.
DB_SSL_CA=
# Writes use authenticated sessions and CSRF tokens, not a shared browser secret.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_MAX_OFFERS=1000

# Google Cloud Console OAuth client (Web application); keep real values in .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/auth/google/callback

# Optional email delivery. Use your HTTPS origin in production (never derive it from Host).
APP_URL=http://127.0.0.1:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
